{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ciel",
  "version": "0.1.0",
  "identifier": "dev.ciel.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' http://localhost:1420 ws://localhost:1420"
    },
    "windows": [
      {
        "title": "Ciel Taller — modelado 3D",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 650,
        "resizable": true,
        "decorations": true,
        "transparent": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
